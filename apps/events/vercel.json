{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://www.parkconscious.in/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://www.parkconscious.in/api/sitemap.js"
    },
    {
      "source": "/robots.txt",
      "destination": "https://www.parkconscious.in/api/robots.js"
    },
    {
      "source": "/event/:id",
      "destination": "https://www.parkconscious.in/api/render-event.js?id=:id"
    },
    {
      "source": "/((?!api/|static/|sitemap\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
